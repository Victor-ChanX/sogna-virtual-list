{
  "name": "sogna-virtual-list",
  "version": "0.1.0",
  "description": "A lightweight React virtual list tuned for chat, feeds, and dynamic-height message UIs.",
  "license": "MIT",
  "author": "Victor Chan",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "NOTICE.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Victor-ChanX/sogna-virtual-list.git"
  },
  "bugs": {
    "url": "https://github.com/Victor-ChanX/sogna-virtual-list/issues"
  },
  "homepage": "https://github.com/Victor-ChanX/sogna-virtual-list#readme",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "react",
    "chat",
    "virtual-list",
    "virtualized",
    "dynamic-height",
    "infinite-scroll"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && vite build",
    "clean": "rm -rf dist",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run test && npm run build && npm run pack:dry-run"
  },
  "peerDependencies": {
    "react": ">=18 || >=19",
    "react-dom": ">=18 || >=19"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.16"
  }
}
